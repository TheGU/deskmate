# deskmate / dashboard-hub configuration.
# Copy to .env and edit. Every other setting (timezone, task/calendar/
# weather/AI usage/brief/Home Assistant/device sources, credentials, TTLs)
# lives on the hub's own settings page (open /setup on a fresh hub, or
# /settings once it is claimed) and is stored in data/deskmate.sqlite, not
# here. See docs/SETTINGS.md for every section and field.
# .env is gitignored. Never commit real tokens.

# Container listens on 8080 as a non-root user. Host port defaults to 80;
# set HUB_PORT when 80 is taken or needs no privileges.
HUB_PORT=80
# uid:gid the container runs as and writes ./data with. Defaults match the
# image's own hub user. Set both to the owner of ./data (`id -u`, `id -g`) if
# that directory belongs to someone else.
#PUID=1001
#PGID=1001

# Host path to an Obsidian vault, if the tasks section's source is set to
# obsidian on the settings page. In Docker this path is bind-mounted read
# only at /vault, and the vault path to enter on the settings page is
# /vault, not this host path.
#OBSIDIAN_VAULT_PATH=D:/Obsidian/MyVault

# DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Process and rendering knobs. These are not settings-page fields: they have
# no meaning to an admin editing sections, only to the process itself.
# ---------------------------------------------------------------------------
# Chromium screenshot timeout, in milliseconds.
RENDER_TIMEOUT_MS=15000
# Timeout for outbound fetches (calendar, weather, Home Assistant), in seconds.
HTTP_TIMEOUT_SECONDS=10
# Shift fixture dates so the demo always looks like today. Set to false to
# read the literal dates in fixtures/*.json. Development only.
FIXTURE_RELATIVE_DATES=true
