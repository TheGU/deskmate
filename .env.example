# Container listens on 8080 as a non-root user. Host port defaults to 80;
# set HUB_PORT when 80 is taken or needs no privileges.
HUB_PORT=80
# uid:gid the container runs as and writes ./data with. Defaults match the
# image's own hub user. Set both to the owner of ./data (`id -u`, `id -g`) if
# that directory belongs to someone else.
#PUID=1001
#PGID=1001

# deskmate / dashboard-hub configuration.
# Copy to .env and edit. Every variable is optional: with no .env at all the
# hub runs entirely from fixtures/ and never touches the network.
# .env is gitignored. Never commit real tokens.

# ---------------------------------------------------------------------------
# Global
# ---------------------------------------------------------------------------
# IANA timezone used for every date and time on the pages.
TIMEZONE=Asia/Bangkok
# metric or imperial.
UNITS=metric
# DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Where the demo data lives (the Docker image sets this to /app/fixtures).
#FIXTURES_DIR=./fixtures
# Where runtime data written by other agents lives (Docker: /data).
#DATA_DIR=./data
# Shift fixture dates so the demo always looks like today. Set to false to
# read the literal dates in fixtures/*.json.
FIXTURE_RELATIVE_DATES=true

# ---------------------------------------------------------------------------
# Tasks: fixture | file | obsidian | auto   (auto: file when a push exists,
# else fixture; obsidian is read only, the vault is never written to)
# ---------------------------------------------------------------------------
TASKS_SOURCE=auto
# Host path to the vault. In Docker this path is bind-mounted read-only at
# /vault and the container overrides OBSIDIAN_VAULT_PATH to /vault.
#OBSIDIAN_VAULT_PATH=D:/Obsidian/MyVault
# Which Markdown files to scan inside the vault.
OBSIDIAN_TASK_GLOB=**/*.md

# ---------------------------------------------------------------------------
# Calendar: fixture | ics
# ---------------------------------------------------------------------------
CALENDAR_SOURCE=fixture
# Comma separated ICS URLs or local .ics file paths.
#CALENDAR_ICS_URLS=https://example.com/basic.ics,/data/work.ics
# Names for those feeds, in the same order. Blank falls back to the URL host,
# then to "calendar 1", "calendar 2". The name is what the agenda legend says.
#CALENDAR_NAMES=work,personal
# Panel colour per feed, in the same order: blue, green, yellow, red or black.
# The agenda and the Today NEXT pane print each event's time in its calendar's
# colour. Anything left unnamed cycles blue, green, yellow.
#CALENDAR_COLORS=blue,green

# ---------------------------------------------------------------------------
# Weather: fixture | open_meteo   (Open-Meteo needs no API key)
# ---------------------------------------------------------------------------
WEATHER_SOURCE=fixture
# No location is assumed. open_meteo reports "unavailable" until both are set.
#WEATHER_LATITUDE=13.7563
#WEATHER_LONGITUDE=100.5018
#WEATHER_LOCATION_NAME=Bangkok

# ---------------------------------------------------------------------------
# AI usage / quota: fixture | file | auto   (auto: file when a push exists,
# else fixture)
# ---------------------------------------------------------------------------
AI_USAGE_SOURCE=auto
# JSON written by a separate collector. Schema: docs/DATA-SOURCES.md.
#AI_USAGE_PATH=/data/ai-usage.json

# ---------------------------------------------------------------------------
# AI brief: fixture | file | auto   (auto: file when a push exists, else
# fixture)
# ---------------------------------------------------------------------------
BRIEF_SOURCE=auto
# Directory holding current.json, or morning.md and evening.md.
#BRIEF_DIR=/data/brief
# Local hour at which the brief switches from morning to evening mode.
BRIEF_EVENING_HOUR=14

# ---------------------------------------------------------------------------
# Home Assistant: fixture | rest
# ---------------------------------------------------------------------------
HA_SOURCE=fixture
#HA_URL=http://homeassistant.local:8123
# Long-lived access token. Keep it here, never on the E1002.
#HA_TOKEN=
# JSON object mapping dashboard slots to entity ids. Slots:
# front_door, doorbell, motion, room_temperature, room_humidity,
# internet, home_assistant, nas, proxmox, backup, assistant, assistant_last_run
#HA_ENTITIES={"front_door":"binary_sensor.front_door","nas":"binary_sensor.nas_online"}

# ---------------------------------------------------------------------------
# Device telemetry: store | fixture
# ---------------------------------------------------------------------------
# store   = only what the E1002 actually POSTed to /api/device/telemetry.
#           This is the right setting in production: with no device on the LAN
#           the System page honestly says NO DEVICE DATA YET.
# fixture = while the store is still empty, fall back to fixtures/device.json
#           so the page and the chart can be worked on before the device is
#           flashed. One real sample makes the fixture disappear for good.
#           The tests and `scripts/render-all.py` default to this.
DEVICE_SOURCE=store
# SQLite file the samples are appended to (Docker: /data/telemetry.sqlite).
#TELEMETRY_DB_PATH=./data/telemetry.sqlite
# Rows older than this are deleted on every insert.
TELEMETRY_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Adapter cache lifetimes, in seconds
# ---------------------------------------------------------------------------
TASKS_TTL_SECONDS=300
CALENDAR_TTL_SECONDS=300
WEATHER_TTL_SECONDS=900
AI_USAGE_TTL_SECONDS=300
BRIEF_TTL_SECONDS=60
HOME_TTL_SECONDS=120
DEVICE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# Staleness thresholds, in seconds (pushed datasets only: ai_usage, brief,
# tasks). Past this age the panel marks the section with a yellow tell-tale
# and an hour-bucketed age, and flags the page's footer entry with "!". A
# fixture-sourced dataset is never marked stale. The age is always bucketed
# to whole hours, so a value under 3600 (one hour) never actually marks
# anything: the mark only ever reads "1 H AGO" or more.
# ---------------------------------------------------------------------------
AI_USAGE_STALE_SECONDS=21600
BRIEF_STALE_SECONDS=36000
TASKS_STALE_SECONDS=36000

# ---------------------------------------------------------------------------
# Rendering and layout
# ---------------------------------------------------------------------------
RENDER_TIMEOUT_MS=15000
HTTP_TIMEOUT_SECONDS=10
# How many tasks the Today page lists.
MAX_PRIORITY_TASKS=3
# How many days the Agenda page covers.
AGENDA_DAYS=7
# Default seconds an alert stays on the device.
ALERT_DEFAULT_DURATION_SECONDS=90
