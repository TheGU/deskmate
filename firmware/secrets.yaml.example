# Copy to firmware/secrets.yaml (gitignored) and fill in real values.

# There is no wifi_ssid/wifi_password here: ESPHome secrets cannot be left
# empty per key (an empty ssid fails `esphome config` validation), so the
# firmware omits ssid/password from wifi: entirely and provisions Wi-Fi at
# runtime instead: connect to the device's own AP ("reTerminal-E1002
# Setup", password ap_password below) and use the captive portal, or send
# credentials over the USB serial port with Improv. Either way ESPHome
# saves them to NVS and they survive OTA. See docs/FLASHING.md,
# "Provisioning at runtime".

# hub_base_url and hub_key only seed the device's Hub base URL and Hub key
# text fields on the very first boot. After that, edit them at
# http://<device-ip>/ (the device's own web page, protected by
# web_username/web_password below) or as Home Assistant text entities;
# neither edit needs a reflash. No trailing slash on the URL.
hub_base_url: "http://192.168.1.50"

# The device key shown once on the hub's setup-done page. The device sends
# it as a bearer header on every image fetch and telemetry post.
hub_key: "REPLACE_WITH_DEVICE_KEY_FROM_SETUP"

# Basic auth for the device's own web page (web_server:). Pick your own.
web_username: "admin"
web_password: "change-me-web"

# Generate with: openssl rand -base64 32   (or the ESPHome dashboard)
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY="
ota_password: "change-me-ota"
ap_password: "change-me-ap"
